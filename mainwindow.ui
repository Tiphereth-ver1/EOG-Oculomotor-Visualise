  <widget class="Graphics_Page" name="graphics">
   <!-- CONFIG: Resize the canvas with the layout, subject to minimum and maximum widget sizes. -->
   <property name="sizePolicy">
    <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
     <horstretch>0</horstretch>
     <verstretch>0</verstretch>
    </sizepolicy>
   </property>
   <!-- CONFIG: Scene rectangle (-600,-350,1200,700); does not alter trajectories. Vertical shift=400 exceeds this initial range. -->
   <property name="sceneRect">
    <rectf>
     <x>-600.000000000000000</x>
     <y>-350.000000000000000</y>
     <width>1200.000000000000000</width>
     <height>700.000000000000000</height>
    </rectf>
   </property>
   <!-- CONFIG: Canvas background RGB color: black; alpha=255 is opaque. -->
   <property name="backgroundBrush">
    <brush brushstyle="SolidPattern">
     <color alpha="255">
      <red>0</red>
      <green>0</green>
      <blue>0</blue>
     </color>
    </brush>
   </property>
   <!-- CONFIG: Shared dot diameter: 24 scene units for all experiments. -->
   <property name="stimulusDiameter" stdset="0">
    <double>24.000000000000000</double>
   </property>
   <!-- CONFIG: Saccade central fixation RGB color: yellow. -->
   <property name="fixationColor" stdset="0">
    <color alpha="255">
     <red>255</red>
     <green>255</green>
     <blue>0</blue>
    </color>
   </property>
   <!-- CONFIG: Peripheral target, fixation task, and pursuit dot RGB color: white. -->
   <property name="targetColor" stdset="0">
    <color alpha="255">
     <red>255</red>
     <green>255</green>
     <blue>255</blue>
    </color>
   </property>
