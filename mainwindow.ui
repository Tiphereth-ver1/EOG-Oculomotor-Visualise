    <font>
     <family>Arial</family>
     <pointsize>48</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <!-- CONFIG: Scene text conversion DPI=100; affects rendered font size. -->
   <property name="sceneTextDpi" stdset="0">
    <number>100</number>
   </property>
   <!-- CONFIG: Title and countdown RGB color: white. -->
